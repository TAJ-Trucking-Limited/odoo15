<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_sale_form_madfox" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name='vehicle_id'  />
                <field name="analytic_account_id"   groups="analytic.group_analytic_accounting" force_save="1"/>
                <field name='file_name' />
                <field name='container_num' />
                <field name='srn' />
                 <field name='consignee' />
                 <field name='size' />
                 <field name='weight' />

            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="vat_tax_id" string="VAT"
                    domain="[('company_id', '=', company_id), ('active', '=', True), ('type_tax_use', '=', 'sale'), ('amount_type', '=', 'percent')]"
                    options="{'no_create': True, 'no_open': True}"/>
            </xpath>

        </field>
    </record>

   

</odoo>
