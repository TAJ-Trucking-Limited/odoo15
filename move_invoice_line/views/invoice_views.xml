<?xml version="1.0"?>
<odoo>
    <record id="report_invoice_document_inherit" model="ir.ui.view">
        <field name="name">taj_report_invoice_document</field>
        <field name="inherit_id" ref="account.report_invoice_document"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='o']" position="after">
                <t t-set="custom_layout_address" t-value="True"/>
            </xpath>

            <!-- Compact top spacing so the customer address sits close beneath the header (old tight layout) -->
            <xpath expr="//div[hasclass('page')]" position="before">
                <style>
                    div[name="company_address"] ul[name="company_address_list"] {
                        line-height: 1.3 !important;
                        margin-bottom: 0 !important;
                    }
                    div[name="company_address"] ul[name="company_address_list"] li {
                        margin-bottom: 0 !important;
                        line-height: 1.3 !important;
                    }
                    div[name="address_not_same_as_shipping"],
                    div[name="address_same_as_shipping"],
                    div[name="no_shipping"] {
                        margin-top: 0 !important;
                        padding-top: 0 !important;
                        line-height: 1.3 !important;
                    }
                    div[name="address_not_same_as_shipping"] address,
                    div[name="address_same_as_shipping"] address,
                    div[name="no_shipping"] address {
                        margin-bottom: 0 !important;
                        line-height: 1.3 !important;
                    }
                    .article > div.row:first-child {
                        margin-top: 0 !important;
                        padding-top: 0 !important;
                    }
                </style>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']" position="before">
                <div class="row text-start">
                    <div class="col-2">
                        <strong>Exchange Rate:</strong>
                    </div>
                    <div class="col-5">
                        <strong t-esc="'{0:,.2f}'.format(int(o.amount_total_signed / o.amount_total) if o.amount_total else 0)"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@id='total']//t[@t-call='account.document_tax_totals']" position="replace">
                <t t-if="o.is_vat_percentage_invoice">
                    <tr class="o_subtotal">
                        <td>
                            <span>Total before Tax</span>
                        </td>
                        <td class="text-end">
                            <span t-out="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                    <tr class="o_taxes">
                        <td>
                            <span t-out="'Total Tax Amount (%s%%)' % ('%g' % o.vat_percentage)"/>
                        </td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                    <tr class="o_total">
                        <td>
                            <strong>Total Amount</strong>
                        </td>
                        <td class="text-end">
                            <strong t-out="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </t>
                <t t-else="">
                    <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-set="currency" t-value="o.currency_id"/>
                    </t>
                </t>
                <tr t-if="o.tax_totals" class="border-black o_total">
                    <td class="col-6">
                        <strong>Total TSH</strong>
                    </td>
                    <td class="text-end col-6">
                        <span t-field="o.amount_total_signed"/>
                    </td>
                </tr>
            </xpath>

            <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"
                           id="inv_tax_id_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//div[@name='no_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[1]" position="after">
                <th>Truck</th>
                <th>Container Number</th>
                <th>Consignee</th>
            </xpath>

            <xpath expr="//t[@name='account_invoice_line_accountable']/td[1]" position="after">
                <td>
                    <span t-if="line.vehicle_id" t-field="line.vehicle_id.license_plate"/>
                </td>
                <td>
                    <span t-if="line.container_num" t-field="line.container_num"/>
                </td>
                <td>
                    <span t-if="line.consignee" t-field="line.consignee"/>
                </td>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th" position="attributes">
                <attribute name="style">vertical-align: top; text-align: center !important;</attribute>
            </xpath>

            <xpath expr="//span[@id='payment_terms_note_id']" position="after">
                <div class="mt-2">
                    <div>Account Name : TAJ TRUCKING LIMITED</div>
                    <div>Account No. USD : 05233990011</div>
                    <div>Swift Transfer : EUAFTZTZ</div>
                    <div>Bank Name : BANK OF AFRICA TANZANIA</div>
                    <div>Bank Address : NDC DEVELOPMENT HOUSE, OHIO STREET/KIVUKONI FRONT</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
