<?xml version="1.0"?>
<odoo>
    <record id="paperformat_invoice" model="report.paperformat">
        <field name="name">TAJ Invoice</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_invoice"/>
    </record>

    <record id="report_invoice_document_inherit" model="ir.ui.view">
        <field name="name">taj_report_invoice_document</field>
        <field name="inherit_id" ref="account.report_invoice_document"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='o']" position="after">
                <t t-set="custom_layout_address" t-value="True"/>
            </xpath>

            <xpath expr="//div[hasclass('page')]" position="before">
                <style>
                    .article &gt; div.pt-5,
                    div.address,
                    div.address div[name="address"] {
                        margin-top: 0 !important;
                        padding-top: 0 !important;
                    }
                    div.address div[name="address"] {
                        margin-left: 0 !important;
                    }
                    div.address {
                        margin-top: 15mm !important;
                    }
                    /* The margin above collapses into .article, so raising it no
                       longer moves the customer block. Pad the inner column
                       instead: padding never collapses. */
                    div.address div[name="address"] {
                        padding-top: 4mm !important;
                    }
                    div[name="company_address"] ul[name="company_address_list"],
                    div[name="company_address"] ul[name="company_address_list"] li,
                    div[name="address_not_same_as_shipping"],
                    div[name="address_same_as_shipping"],
                    div[name="no_shipping"],
                    div[name="address_not_same_as_shipping"] address,
                    div[name="address_same_as_shipping"] address,
                    div[name="no_shipping"] address {
                        line-height: 1.3 !important;
                        margin-bottom: 0 !important;
                    }
                    .article &gt; div.row:first-child {
                        margin-top: 0 !important;
                        padding-top: 0 !important;
                    }
                    .taj-bank-details {
                        margin-top: 34mm !important;
                    }
                    .taj-bank-details &gt; div {
                        margin-bottom: 0.15rem;
                    }
                    table[name="invoice_line_table"] {
                        table-layout: fixed;
                        width: 100%;
                    }
                    table[name="invoice_line_table"] th {
                        vertical-align: top !important;
                        white-space: nowrap;
                        text-align: center !important;
                        padding: 0.35rem 0.25rem;
                    }
                    table[name="invoice_line_table"] th:nth-child(1),
                    table[name="invoice_line_table"] td:nth-child(1) { width: 25%; }
                    table[name="invoice_line_table"] th:nth-child(2),
                    table[name="invoice_line_table"] td:nth-child(2) { width: 10%; }
                    table[name="invoice_line_table"] th:nth-child(3),
                    table[name="invoice_line_table"] td:nth-child(3) { width: 16%; }
                    table[name="invoice_line_table"] th:nth-child(4),
                    table[name="invoice_line_table"] td:nth-child(4) { width: 15%; }
                    table[name="invoice_line_table"] th:nth-child(5),
                    table[name="invoice_line_table"] td:nth-child(5) { width: 11%; }
                    table[name="invoice_line_table"] th:nth-child(6),
                    table[name="invoice_line_table"] td:nth-child(6) { width: 11%; }
                    table[name="invoice_line_table"] th:nth-child(7),
                    table[name="invoice_line_table"] td:nth-child(7) { width: 12%; }
                    table[name="invoice_line_table"] td {
                        vertical-align: top;
                        padding: 0.35rem 0.25rem;
                        overflow-wrap: anywhere;
                    }
                    table[name="invoice_line_table"] th:nth-child(5),
                    table[name="invoice_line_table"] th:nth-child(6),
                    table[name="invoice_line_table"] th:nth-child(7),
                    table[name="invoice_line_table"] td:nth-child(5),
                    table[name="invoice_line_table"] td:nth-child(6),
                    table[name="invoice_line_table"] td:nth-child(7) {
                        text-align: right !important;
                        white-space: nowrap;
                    }
                </style>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']" position="before">
                <div class="row text-start">
                    <div class="col-2">
                        <strong>Exchange Rate:</strong>
                    </div>
                    <div class="col-5">
                        <strong t-esc="'{0:,.2f}'.format(int(o.amount_total_signed / o.amount_total) if o.amount_total else 0)"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@id='total']//t[@t-call='account.document_tax_totals']" position="replace">
                <tr t-if="o.tax_totals" class="o_total">
                    <td class="col-6">
                        <strong>Total</strong>
                    </td>
                    <td class="text-end col-6">
                        <strong t-field="o.amount_total"/>
                    </td>
                </tr>
                <tr t-if="o.tax_totals" class="border-black o_total">
                    <td class="col-6">
                        <strong>Total TSH</strong>
                    </td>
                    <td class="text-end col-6">
                        <span t-field="o.amount_total_signed"/>
                    </td>
                </tr>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_taxes']" position="replace"/>
            <xpath expr="//td[@name='td_taxes']" position="replace"/>
            <xpath expr="//td[@name='td_taxes_grouped']" position="replace"/>

            <xpath expr="//t[@t-if=&quot;o.tax_totals and o.tax_totals.get('display_in_company_currency')&quot;]" position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>

            <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"
                           id="inv_tax_id_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//div[@name='no_shipping']/t[@t-set='address']" position="replace">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                           t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">TIN NO</t>:
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    <t t-if="o.partner_id.vrn">VRN NO:
                        <span t-field="o.partner_id.vrn"/>
                    </t>
                </t>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[1]" position="after">
                <th>Truck</th>
                <th>Container<br/>Number</th>
                <th>Consignee</th>
            </xpath>

            <xpath expr="//t[@name='account_invoice_line_accountable']/td[1]" position="after">
                <td>
                    <span t-if="line.vehicle_id" t-field="line.vehicle_id.license_plate"/>
                </td>
                <td>
                    <span t-if="line.container_num" t-field="line.container_num"/>
                </td>
                <td>
                    <span t-if="line.consignee" t-field="line.consignee"/>
                </td>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th" position="attributes">
                <attribute name="style">vertical-align: top; text-align: center !important; white-space: nowrap;</attribute>
            </xpath>

            <xpath expr="//span[@id='payment_terms_note_id']" position="after">
                <div class="mt-2 taj-bank-details">
                    <div>Account Name : TAJ TRUCKING LIMITED</div>
                    <div>Account No. USD : 05233990011</div>
                    <div>Swift Transfer : EUAFTZTZ</div>
                    <div>Bank Name : BANK OF AFRICA TANZANIA</div>
                    <div>Bank Address : NDC DEVELOPMENT HOUSE, OHIO STREET/KIVUKONI FRONT</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
