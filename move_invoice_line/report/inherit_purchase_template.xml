<?xml version="1.0"?>
<odoo>
    <!-- ponytail: wkhtmltopdf keeps the logo in a 52mm header band; the vendor
         address lives in the body, so CSS top:-17mm cannot close that gap.
         Shrink the PO header band to the actual logo+company-details height. -->
    <record id="paperformat_purchase_order" model="report.paperformat">
        <field name="name">TAJ Purchase Order</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_purchase_order"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_purchase_order"/>
    </record>

    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='o']" position="after">
            <t t-set="custom_layout_address" t-value="True"/>
            <t t-set="taj_hide_information_block" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="row mb-4">
                <div t-if="o.partner_ref" class="col">
                    <strong>Your Order Reference</strong>
                    <div t-field="o.partner_ref"/>
                </div>
                <div t-if="o.date_order" class="col">
                    <strong>Order Date</strong>
                    <div t-field="o.date_order" t-options="{'date_only': 'true'}"/>
                </div>
                <div t-if="o.incoterm_id" class="col">
                    <strong>Incoterm</strong>
                    <div t-field="o.incoterm_id.code"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[@name='th_description']" position="after">
            <th class="text-start"><strong>Truck Number</strong></th>
            <th class="text-start"><strong>Container</strong></th>
            <th class="text-start"><strong>Route</strong></th>
            <th class="text-start"><strong>Cargo Type</strong></th>
            <th class="text-start"><strong>Date Req.</strong></th>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/tbody//td[@id='product']" position="after">
            <td class="text-start">
                <span t-field="line.truck_number"/>
            </td>
            <td class="text-start">
                <span t-if="line.source_sale_line_id" t-field="line.source_sale_line_id.container_num"/>
            </td>
            <td class="text-start">
                <span t-field="line.rout"/>
            </td>
            <td class="text-start">
                <span t-field="line.cargo_type"/>
            </td>
            <td class="text-start">
                <span t-field="line.date_planned"/>
            </td>
        </xpath>
    </template>

    <template id="address_layout_hide_purchase_information" inherit_id="web.address_layout" priority="99">
        <xpath expr="//div[@name='information_block']/.." position="attributes">
            <attribute name="t-att-style">'padding-top: 0 !important;' if taj_hide_information_block else None</attribute>
        </xpath>
        <xpath expr="//div[@name='information_block']" position="attributes">
            <attribute name="t-att-style">'display: none !important;' if taj_hide_information_block else None</attribute>
        </xpath>
    </template>
</odoo>
