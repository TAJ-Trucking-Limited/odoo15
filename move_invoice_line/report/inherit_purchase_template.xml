<?xml version="1.0"?>
<odoo>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='o']" position="after">
            <t t-set="custom_layout_address" t-value="True"/>
        </xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="False"/>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="before">
            <style>
                div[name="information_block"] {
                    display: none !important;
                }
            </style>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="row mb-4">
                <div t-if="o.partner_ref" class="col">
                    <strong>Your Order Reference</strong>
                    <div t-field="o.partner_ref"/>
                </div>
                <div t-if="o.date_order" class="col">
                    <strong>Order Date</strong>
                    <div t-field="o.date_order" t-options="{'date_only': 'true'}"/>
                </div>
                <div t-if="o.incoterm_id" class="col">
                    <strong>Incoterm</strong>
                    <div t-field="o.incoterm_id.code"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[@name='th_description']" position="after">
            <th class="text-start"><strong>Truck Number</strong></th>
            <th class="text-start"><strong>Container</strong></th>
            <th class="text-start"><strong>Route</strong></th>
            <th class="text-start"><strong>Cargo Type</strong></th>
            <th class="text-start"><strong>Date Req.</strong></th>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/tbody//td[@id='product']" position="after">
            <td class="text-start">
                <span t-field="line.truck_number"/>
            </td>
            <td class="text-start">
                <span t-if="line.source_sale_line_id" t-field="line.source_sale_line_id.container_num"/>
            </td>
            <td class="text-start">
                <span t-field="line.rout"/>
            </td>
            <td class="text-start">
                <span t-field="line.cargo_type"/>
            </td>
            <td class="text-start">
                <span t-field="line.date_planned"/>
            </td>
        </xpath>
    </template>
</odoo>
