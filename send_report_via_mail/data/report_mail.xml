<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete id="email_template_report_pdf" model="mail.template"/>

    <data noupdate="1">
        <record id="email_from_parameter" model="ir.config_parameter">
            <field name="key">send_report_via_mail.email_from</field>
            <field name="value">odoobot@taj-limited.odoo.com</field>
        </record>
        <record id="email_to_parameter" model="ir.config_parameter">
            <field name="key">send_report_via_mail.email_to</field>
            <field name="value">kreik.ali@gmail.com</field>
        </record>
        <record id="email_cc_parameter" model="ir.config_parameter">
            <field name="key">send_report_via_mail.email_cc</field>
            <field name="value">nour.m@madfoxme.com; Moustapha@madfoxme.com; souzan.s@madfoxme.com</field>
        </record>

        <record id="report_cron" model="ir.cron">
            <field name="name">Send Report Via Email</field>
            <field name="active" eval="False"/>
            <field name="state">code</field>
            <field name="model_id" ref="model_report_send_mail"/>
            <field name="code">model.send_email_with_pdf_attach()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 19:00:00')"/>
        </record>
    </data>
</odoo>
