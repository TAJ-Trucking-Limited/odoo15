<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_navirec_report_subscription_view_list" model="ir.ui.view">
        <field name="name">fleet.navirec.report.subscription.list</field>
        <field name="model">fleet.navirec.report.subscription</field>
        <field name="arch" type="xml">
            <list string="Client Tracking Reports">
                <field name="active"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_ids" widget="many2many_tags"/>
                <field name="timezone" optional="hide"/>
                <field name="next_send_at"/>
                <field name="last_sent_at" optional="show"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="fleet_navirec_report_subscription_view_form" model="ir.ui.view">
        <field name="name">fleet.navirec.report.subscription.form</field>
        <field name="model">fleet.navirec.report.subscription</field>
        <field name="arch" type="xml">
            <form string="Client Tracking Report">
                <header>
                    <button name="action_preview_report"
                        type="object"
                        string="Preview Report"
                        class="btn-secondary"/>
                    <button name="action_send_now"
                        type="object"
                        string="Send Now"
                        class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                        title="Inactive"
                        bg_color="text-bg-secondary"
                        invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Client &amp; Recipients">
                            <field name="active"/>
                            <field name="partner_id"/>
                            <field name="email_to"
                                placeholder="ops@example.com"/>
                            <field name="email_cc"
                                placeholder="manager@example.com"/>
                        </group>
                        <group string="Schedule">
                            <field name="timezone"
                                placeholder="Africa/Dar_es_Salaam"/>
                            <field name="send_time_1"
                                placeholder="08:00"/>
                            <field name="send_time_2"
                                placeholder="13:00"/>
                            <field name="send_time_3"
                                placeholder="18:00"/>
                            <field name="next_send_at" readonly="1"/>
                            <field name="last_sent_at" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tracked Vehicles" name="tracked_vehicles">
                            <field name="vehicle_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"/>
                        </page>
                        <page string="Report Fields" name="report_fields">
                            <group>
                                <group>
                                    <field name="field_vehicle"/>
                                    <field name="field_license_plate"/>
                                    <field name="field_status" readonly="1"/>
                                    <field name="field_location"/>
                                    <field name="field_coordinates"/>
                                </group>
                                <group>
                                    <field name="field_last_gps" readonly="1"/>
                                    <field name="field_speed"/>
                                    <field name="field_ignition"/>
                                    <field name="field_odometer"/>
                                </group>
                            </group>
                        </page>
                        <page string="Delivery Status" name="delivery_status">
                            <group>
                                <group>
                                    <field name="last_attempt_at" readonly="1"/>
                                    <field name="last_sent_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_error_at" readonly="1"
                                        invisible="not last_error"/>
                                    <field name="last_error" readonly="1"
                                        invisible="not last_error"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fleet_navirec_report_preview_view_form" model="ir.ui.view">
        <field name="name">fleet.navirec.report.preview.form</field>
        <field name="model">fleet.navirec.report.preview</field>
        <field name="arch" type="xml">
            <form string="Fleet Position Report Preview">
                <sheet>
                    <field name="subscription_id" invisible="1"/>
                    <field name="body_html"
                        widget="html"
                        readonly="1"
                        nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_send_now"
                        type="object"
                        string="Send Now"
                        class="btn-primary"/>
                    <button string="Close"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="fleet_navirec_report_subscription_action"
        model="ir.actions.act_window">
        <field name="name">Client Tracking Reports</field>
        <field name="res_model">fleet.navirec.report.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="fleet_navirec_report_subscription_menu"
        name="Client Tracking Reports"
        parent="fleet.fleet_configuration"
        action="fleet_navirec_report_subscription_action"
        sequence="80"
        groups="fleet.fleet_group_manager"/>
</odoo>
