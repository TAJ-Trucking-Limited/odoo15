<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_cheque_wizard_form" model="ir.ui.view">
        <field name="name">account.cheque.wizard.form</field>
        <field name="model">account.cheque.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Cheque">
                <group>
                    <field name="payment_id" readonly="1" invisible="1"/>
                </group>

                <group col="2">
                    <field name="cheque_number"/>
                    <field name="payee_id"/>
                    <field name="amount" readonly="payment_id != False"/>
                    <field name="currency_id" readonly="payment_id != False"/>
                    <field name="amount_in_words" readonly="1"/>
                </group>

                <group>
                    <field name="reason_note"/>
                </group>

                <footer>
                    <button
                        name="action_print_cheque_and_voucher"
                        string="Print Cheque"
                        type="object"
                        class="btn-primary"
                    />
                    <button name="action_preview"
                            string="Preview Cheque"
                            type="object"
                            class="btn-secondary"/>


                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_open_cheque_wizard" model="ir.actions.act_window">
        <field name="name">Print Cheque</field>
        <field name="res_model">account.cheque.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>
</odoo>
