<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cheque_voucher">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="doc">

                    <!-- Linked bill via smart button -->
                    <t t-set="bill" t-value="doc.payment_id.reconciled_bill_ids[:1]" t-if="doc.payment_id"/>

                    <div class="page">

                        <!-- TITLE -->
                        <h2 style="text-align:center; margin-bottom:35px;">
                            Cheque Payment Voucher
                        </h2>

                        <!-- SECTION: CHEQUE INFO -->
                        <table class="table-borderless" style="width:100%;">
                            <tr>
                                <td width="30%"><strong>Cheque Reference</strong></td>
                                <td width="70%" t-esc="doc.name"/>
                            </tr>
                            <tr>
                                <td><strong>Cheque Number</strong></td>
                                <td t-esc="doc.cheque_number"/>
                            </tr>
                            <tr>
                                <td><strong>Print Date</strong></td>
                                <td t-esc="doc.print_date"/>
                            </tr>

                            <t t-if="doc.payment_id">
                                <tr>
                                    <td><strong>Payment Reference</strong></td>
                                    <td t-esc="doc.payment_id.name"/>
                                </tr>
                            </t>
                        </table>

                        <div style="border-bottom:2px solid black;width:100%; height:2px; margin:15px 0;"/>

                        <!-- SECTION: PAYEE INFO -->
                        <table class="table-borderless" style="width:100%;">
                            <tr>
                                <td width="30%"><strong>Payee Name</strong></td>
                                <td width="70%" t-esc="doc.payee_id.name"/>
                            </tr>

                            <t t-if="doc.payment_id">
                                <tr>
                                    <td><strong>Partner Address</strong></td>
                                    <td t-esc="doc.payment_id.partner_id.contact_address or ''"/>
                                </tr>
                                <tr>
                                    <td><strong>Phone</strong></td>
                                    <td t-esc="doc.payment_id.partner_id.phone or ''"/>
                                </tr>
                                <tr>
                                    <td><strong>Email</strong></td>
                                    <td t-esc="doc.payment_id.partner_id.email or ''"/>
                                </tr>
                            </t>
                        </table>

                        <div style="border-bottom:2px solid black;width:100%; height:2px; margin:15px 0;"/>

                        <!-- Partner Comparison Note -->
                        <t t-if="doc.partner_comparison_note">
                            <div style="margin-top:10px; font-size:15px; color:black;">
                                <strong>Note:</strong>
                                <t t-esc="doc.partner_comparison_note"/>
                            </div>
                            <div style="border-bottom:2px solid black;width:100%; height:2px; margin:15px 0;"/>
                        </t>

                        <!-- SECTION: AMOUNTS -->
                        <table class="table-borderless" style="width:100%;">
                            <tr>
                                <td width="30%"><strong>Cheque Amount</strong></td>
                                <td width="70%">
                                    <strong>
                                        <t t-esc="'{:,.2f}'.format(doc.amount)"/>
                                        <t t-esc="doc.currency_id.name"/>
                                    </strong>
                                </td>
                            </tr>

                            <t t-if="bill">
                                <tr>
                                    <td><strong>Total Due Amount</strong></td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(bill.amount_total)"/>
                                        <t t-esc="bill.currency_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Remaining Balance</strong></td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(bill.amount_residual)"/>
                                        <t t-esc="bill.currency_id.name"/>
                                    </td>
                                </tr>
                            </t>
                        </table>

                        <div style="border-bottom:2px solid black;width:100%; height:2px; margin:15px 0;"/>

                        <!-- SECTION: NOTES -->
                        <table class="table-borderless" style="width:100%;">
                            <tr>
                                <td width="30%"><strong>Reason / Note</strong></td>
                                <td width="70%" t-esc="doc.reason_note"/>
                            </tr>
                        </table>

                        <div style="border-bottom:2px solid black;width:100%; height:2px; margin:15px 0;"/>

                        <!-- FOOTER -->
                        <table class="table-borderless" style="width:100%; margin-top:50px;">
                            <tr>
                                <td width="40%" style="margin-bottom:10px;">
                                    <span style="margin-bottom:25px;">Printed by:</span><br/>
                                    <span><t t-esc="doc.env.user.name"/></span>
                                </td>

                                <td width="30%" style="text-align:center; margin-bottom:10px;">
                                    Accountant Signature<br/><br/>
                                    <span style="margin-top:10px;">_______________________</span>
                                </td>

                                <td width="30%" style="text-align:center;">
                                    Received By<br/><br/>
                                    <span style="margin-top:10px;">_______________________</span>
                                </td>
                            </tr>
                        </table>

                    </div>

                </t>
            </main>
        </t>
    </template>
    <record id="report_voucher_pdf" model="ir.actions.report">
        <field name="name">Cheque Voucher</field>
        <field name="model">account.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_cheque_printing.report_cheque_voucher</field>
        <field name="report_file">account_cheque_printing.report_cheque_voucher</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">object.cheque_number</field>
    </record>


</odoo>
