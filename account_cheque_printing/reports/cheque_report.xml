<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cheque">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="doc" t-value="docs[0]"/>

                <script type="text/javascript">
                    var isDownloaded = false;

                    function downloadVoucherPDF() {
                        if (isDownloaded) return;
                        isDownloaded = true;

                        var paymentId = <t t-esc="doc.id"/>;
                        var url = '/report/pdf/account_cheque_printing.report_cheque_voucher/' + paymentId + '?download=true';

                        var a = document.createElement('a');
                        a.href = url;
                        a.download = '<t t-esc="doc.cheque_number"/>' + '.pdf';

                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                    }

                    window.onload = function () {
                        window.print();
                    };

                    window.onafterprint = function() {
                        downloadVoucherPDF();
                    };
                </script>

                <t t-set="print_date" t-value="doc.print_date or doc.create_date"/>

                <!-- A4 Container -->
                <div style="
                    position: relative;
                    width: 210mm;
                    height: 297mm;
                    margin: 0 auto;
                ">

                    <!-- Cheque centered -->
                    <div style="
                        position: absolute;
                        top: 35%;
                        left: 50%;
                        width: 203mm;
                        height: 91mm;
                        transform: translate(-50%, -50%) rotate(90deg);
                        transform-origin: center center;
                        background-size: 203mm 91mm;
                        background-repeat: no-repeat;
                    ">

                        <!-- Payee -->
                        <span style="position:absolute; top:16mm; left:0.2mm; font-size:13pt;">
                            <t t-esc="doc.payee_id.name"/>
                        </span>

                        <!-- Amount in words -->
                        <span style="position:absolute; top:27.3mm; left:10mm; width:120mm; font-size:13pt;">
                            <t t-esc="doc.amount_in_words"/>
                        </span>

                        <!-- Amount number -->
                        <span style="position:absolute; top:39mm; left:216mm; font-size:13pt;">
                            <t t-esc="'{:,.2f}'.format(doc.amount)"/>
                        </span>

                        <!-- Day -->
                        <span style="position:absolute; top:3mm; left:212mm; font-size:13pt; letter-spacing:9px;">
                            <t t-esc="print_date.strftime('%d')"/>
                        </span>

                        <!-- Month -->
                        <span style="position:absolute; top:3mm; left:231mm; font-size:13pt; letter-spacing:9px;">
                            <t t-esc="print_date.strftime('%m')"/>
                        </span>

                        <!-- Year -->
                        <span style="position:absolute; top:3mm; left:249mm; font-size:13pt; letter-spacing:13px;">
                            <t t-esc="print_date.strftime('%Y')"/>
                        </span>

                    </div>
                </div>

            </t>
        </t>
    </template>

    <record id="report_cheque_html" model="ir.actions.report">
        <field name="name">Cheque Report</field>
        <field name="model">account.cheque</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_cheque_printing.report_cheque</field>
        <field name="report_file">account_cheque_printing.report_cheque</field>
        <field name="print_report_name">'Cheque - %s' % (object.name)</field>
    </record>

</odoo>
