<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fill_empty_trip_fields_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.fill.empty.fields.wizard.form</field>
        <field name="model">taj.transport.fill.empty.fields.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Empty Trip Fields">
                <field name="trip_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="has_assignment" invisible="1"/>
                <field name="milestone_count" invisible="1"/>
                <field name="empty_field_names" invisible="1" force_save="1"/>
                <div class="alert alert-info" role="status" invisible="empty_field_names">
                    There are no empty trip fields you can edit here.
                </div>
                <div class="alert alert-info" role="status"
                     invisible="state not in ('completed', 'cancelled')">
                    This trip is closed. You can still add missing proof of
                    delivery details. Operational fields remain locked.
                </div>
                <group string="Commercial"
                       invisible="'transporter_id' not in empty_field_names and 'transport_reference' not in empty_field_names">
                    <field name="transporter_id" invisible="'transporter_id' not in empty_field_names"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="transport_reference" invisible="'transport_reference' not in empty_field_names"/>
                </group>
                <group string="Cargo"
                       invisible="'cargo_type_id' not in empty_field_names and 'cargo_description' not in empty_field_names and 'special_handling_instructions' not in empty_field_names">
                    <field name="cargo_type_id" invisible="'cargo_type_id' not in empty_field_names"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="cargo_description" invisible="'cargo_description' not in empty_field_names"/>
                    <field name="special_handling_instructions" invisible="'special_handling_instructions' not in empty_field_names"/>
                </group>
                <group string="Route &amp; Timing"
                       invisible="'route_id' not in empty_field_names and 'origin_location' not in empty_field_names and 'destination_location' not in empty_field_names and 'route_notes' not in empty_field_names and 'planned_departure_at' not in empty_field_names and 'planned_arrival_at' not in empty_field_names and 'actual_departure_at' not in empty_field_names and 'actual_arrival_at' not in empty_field_names">
                    <field name="route_id" invisible="'route_id' not in empty_field_names"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="origin_location" invisible="'origin_location' not in empty_field_names"/>
                    <field name="destination_location" invisible="'destination_location' not in empty_field_names"/>
                    <field name="route_notes" invisible="'route_notes' not in empty_field_names"/>
                    <field name="planned_departure_at" invisible="'planned_departure_at' not in empty_field_names"/>
                    <field name="planned_arrival_at" invisible="'planned_arrival_at' not in empty_field_names"/>
                    <field name="actual_departure_at" invisible="'actual_departure_at' not in empty_field_names"/>
                    <field name="actual_arrival_at" invisible="'actual_arrival_at' not in empty_field_names"/>
                </group>
                <group string="Proof of Delivery"
                       invisible="'pod_file' not in empty_field_names and 'pod_notes' not in empty_field_names">
                    <field name="pod_file" filename="pod_filename" invisible="'pod_file' not in empty_field_names"/>
                    <field name="pod_filename" invisible="1"/>
                    <field name="pod_notes" invisible="'pod_notes' not in empty_field_names"/>
                </group>
                <group string="Sales Fields (Read Only)" invisible="not missing_sales_fields">
                    <field name="missing_sales_fields" nolabel="1"/>
                    <p class="text-muted">Fill these fields on the linked sales order.</p>
                    <button name="action_open_sale_order" type="object"
                            string="Save &amp; Open Sales Order" class="btn-secondary"/>
                </group>
                <group string="Resources (Read Only)" invisible="not missing_resource_fields">
                    <field name="missing_resource_fields" nolabel="1"/>
                    <p class="text-muted">Use the resource actions to preserve assignment history.</p>
                    <button name="action_open_resources" type="object"
                            string="Save &amp; Assign Resources" class="btn-secondary"
                            invisible="has_assignment or state != 'draft'"/>
                    <button name="action_open_resources" type="object"
                            string="Save &amp; Replace Resources" class="btn-secondary"
                            invisible="not has_assignment or state in ('completed', 'cancelled')"/>
                </group>
                <group string="Milestones (Read Only)" invisible="not missing_milestone_fields">
                    <field name="missing_milestone_fields" nolabel="1"/>
                    <p class="text-muted">
                        A route template generates checkpoints. You can also
                        add checkpoints using the trip's milestone actions.
                    </p>
                    <button name="action_open_add_checkpoint" type="object"
                            string="Save &amp; Add Checkpoint" class="btn-secondary"
                            invisible="milestone_count or state in ('completed', 'cancelled')"/>
                </group>
                <group string="Lifecycle (Read Only)" invisible="not missing_lifecycle_fields">
                    <field name="missing_lifecycle_fields" nolabel="1"/>
                    <p class="text-muted">
                        Lifecycle timestamps are recorded by the trip's
                        Ready, Start, Complete and Cancel actions.
                    </p>
                </group>
                <footer>
                    <button name="action_save" type="object" string="Save"
                            class="btn-primary" invisible="not empty_field_names"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
