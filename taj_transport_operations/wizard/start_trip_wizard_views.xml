<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_start_trip_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.start.trip.wizard.form</field>
        <field name="model">taj.transport.start.trip.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Trip">
                <group>
                    <field name="trip_id"/>
                    <field name="actual_start_at"/>
                </group>
                <p class="text-muted">The start defaults to now. Change it if the trip started earlier.</p>
                <footer>
                    <button name="action_start" string="Start Trip" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
