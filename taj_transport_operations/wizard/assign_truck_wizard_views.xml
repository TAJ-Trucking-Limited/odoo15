<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_truck_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.assign.truck.wizard.form</field>
        <field name="model">taj.transport.assign.truck.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Truck">
                <field name="sale_line_id" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="product_id"/>
                        <field name="current_vehicle_id"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="vehicle_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <p class="text-muted">
                    Assigns the first truck to the Sales line. If an unassigned
                    Draft trip already exists, its resources are assigned too.
                    This action does not create a trip or replace an existing truck.
                </p>
                <footer>
                    <button name="action_assign_truck" string="Assign Truck"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
