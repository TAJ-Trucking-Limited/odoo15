<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_truck_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.assign.truck.wizard.form</field>
        <field name="model">taj.transport.assign.truck.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Truck">
                <field name="sale_line_id" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="product_id"/>
                        <field name="current_vehicle_id"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="vehicle_id" options="{'no_create': True}"/>
                        <field name="trailer_id" options="{'no_create': True}"/>
                        <field name="driver_id" options="{'no_create': True}"/>
                        <field name="etol" required="1" options="{'numeric': True}"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not sale_order_conflict_note">
                    <field name="sale_order_conflict_note" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not in_progress_trip_note">
                    <field name="in_progress_trip_note" readonly="1" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Assigns the first truck, optional trailer and selected driver to
                    the Sales line. Trailer and driver default from Fleet but can be
                    changed or cleared. Saving also updates the truck's default
                    trailer pairing. If a Draft trip exists, the selection is recorded
                    as its initial resources; otherwise the choices are saved for later
                    trip creation. This action does not create a trip or replace an
                    existing truck.
                </p>
                <footer>
                    <button name="action_assign_truck" string="Assign Truck"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
