<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_replace_resource_assignment_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.replace.assignment.wizard.form</field>
        <field name="model">taj.transport.replace.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Trip Resources">
                <group>
                    <field name="trip_id" readonly="1"/>
                    <field name="expected_assignment_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <group>
                    <group string="Resources After Replacement">
                        <field name="vehicle_id" options="{'no_create': True}"/>
                        <field name="trailer_id" options="{'no_create': True}"/>
                        <field name="driver_id" options="{'no_quick_create': True}"/>
                        <field name="co_driver_id" options="{'no_quick_create': True}"/>
                    </group>
                    <group string="Change Details">
                        <field name="effective_from"/>
                        <field name="effective_location"/>
                        <field name="reason" required="1"/>
                        <field name="notes"/>
                    </group>
                </group>
                <p class="text-muted">
                    Unchanged resources stay assigned. Cleared resources become
                    unassigned. The current period will close at the effective
                    time; a new immutable history row will open.
                </p>
                <footer>
                    <button string="Replace Resources"
                            name="action_replace_resources"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
