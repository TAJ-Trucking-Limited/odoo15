<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_confirm_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.sale.confirm.wizard.form</field>
        <field name="model">taj.transport.sale.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Sales Order">
                <field name="sale_order_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="warning_message" readonly="1" nolabel="1"/>
                </div>
                <p class="text-muted">
                    Click Confirm Order to confirm it anyway, or cancel and fill the fields first.
                </p>
                <footer>
                    <button name="action_confirm_order" type="object"
                            string="Confirm Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
