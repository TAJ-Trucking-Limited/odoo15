<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_initial_resource_assignment_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.initial.assignment.wizard.form</field>
        <field name="model">taj.transport.initial.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Initial Trip Resources">
                <group>
                    <field name="available_trip_ids" invisible="1"/>
                    <field name="trip_id" readonly="not context.get('select_trip_for_vehicle')"
                           domain="[('id', 'in', available_trip_ids)]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="vehicle_id" readonly="context.get('select_trip_for_vehicle', False)"
                           required="context.get('select_trip_for_vehicle', False)"
                           options="{'no_create': True}"/>
                    <field name="trailer_id" options="{'no_create': True}"/>
                    <field name="driver_id" options="{'no_quick_create': True}"/>
                    <field name="co_driver_id" options="{'no_quick_create': True}"/>
                    <field name="effective_from"/>
                    <field name="effective_location"/>
                    <field name="reason"/>
                    <field name="notes"/>
                </group>
                <p class="text-muted">
                    Selecting a truck suggests its driver from Fleet. You can
                    choose another driver for this trip.
                    Select at least one resource. Only Draft trips without
                    assignment history can receive an initial assignment.
                    Use Replace Resources to change an existing assignment.
                </p>
                <footer>
                    <button string="Assign Resources"
                            name="action_assign_initial_resources"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
