<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_price_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.sale.price.wizard.form</field>
        <field name="model">taj.transport.sale.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Unit Price">
                <group>
                    <field name="sale_line_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="price_unit"/>
                </group>
                <footer>
                    <button name="action_update_price" string="Save Price" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
