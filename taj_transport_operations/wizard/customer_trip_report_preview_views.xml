<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_trip_report_table">
        <div class="table-responsive">
            <table class="table table-sm table-bordered text-nowrap">
                <thead>
                    <tr t-if="time_heading">
                        <th colspan="2" t-out="time_heading"/>
                        <th t-foreach="groups" t-as="group" colspan="3" class="text-center" t-out="group"/>
                    </tr>
                    <tr>
                        <th t-foreach="headers" t-as="header" scope="col" t-out="header"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row">
                        <td t-foreach="row" t-as="value" t-out="value"/>
                    </tr>
                    <tr t-if="not rows">
                        <td t-att-colspan="len(headers)" class="text-muted">No checkpoints to show.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <record id="view_customer_trip_report_preview_form" model="ir.ui.view">
        <field name="name">taj.transport.customer.report.preview.form</field>
        <field name="model">taj.transport.customer.report.preview</field>
        <field name="arch" type="xml">
            <form string="Trip Report Preview" create="0" edit="0">
                <field name="comparison_only" invisible="1"/>
                <group invisible="comparison_only">
                    <group>
                        <field name="customer_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="email_to"/>
                        <field name="email_cc" invisible="not email_cc"/>
                    </group>
                </group>
                <notebook>
                    <page string="Trips" name="trips" invisible="comparison_only">
                        <field name="trips_html" widget="html" nolabel="1"/>
                    </page>
                    <page string="Checkpoints" name="checkpoints" invisible="comparison_only">
                        <field name="checkpoints_html" widget="html" nolabel="1"/>
                    </page>
                    <page string="Milestone Comparison" name="milestone_comparison">
                        <field name="comparison_html" widget="html" nolabel="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_download_xlsx" string="Download Excel" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
