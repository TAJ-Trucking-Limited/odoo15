<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_transport_trips_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.trip.create.wizard.form</field>
        <field name="model">taj.transport.trip.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Transport Trips">
                <field name="no_vehicle_on_order" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not no_vehicle_on_order">
                    <strong>No truck assigned.</strong>
                    None of this sales order's product lines has a truck, so no
                    transport trip can be created. Cancel and assign a truck on
                    the sales order lines first.
                </div>
                <group>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                <field name="selection_ids">
                    <list editable="bottom">
                        <field name="sale_order_id" column_invisible="1"/>
                        <field name="sale_line_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="product_id" optional="show"/>
                        <field name="product_tmpl_id" column_invisible="1"/>
                        <field name="company_id" column_invisible="1"/>
                        <field name="existing_trip_id" optional="show"/>
                        <field name="needs_route" column_invisible="1"/>
                        <field name="matching_route_count" optional="hide"/>
                        <field name="route_id"
                               options="{'no_create': True, 'no_create_edit': True}"
                               readonly="not needs_route"/>
                    </list>
                </field>
                <p class="text-muted">
                    Only select actual transport/freight lines. Truck-assigned
                    lines without trips are suggested by default. A line needs
                    a truck on the sales order before a trip can be created.
                    Existing trips will be reused; no duplicate trips created.
                </p>
                <p class="text-muted">
                    Each new trip needs a route template linked to that line's
                    product. When exactly one active template matches, it is
                    selected automatically. When several match, choose one per
                    line. Unlinked legacy templates are not offered here.
                </p>
                <footer>
                    <button name="action_create_trips" type="object"
                            string="Create / Open Trips" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
