<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_sale_allocation_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.vehicle.sale.allocation.wizard.form</field>
        <field name="model">taj.transport.vehicle.sale.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Truck to Sales Order">
                <group>
                    <field name="vehicle_id" readonly="1"/>
                    <field name="sale_order_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="sale_line_id" context="{'transport_line_label': True}"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="driver_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="etol" required="1"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="not planned_sale_line_count">
                    <field name="planned_sale_line_count" readonly="1" class="d-inline"/>
                    existing planned Sales shipment(s) already use this truck.
                    Check the loading schedule before assigning another one.
                </div>
                <p class="text-muted">
                    Only confirmed Sales Order lines without a truck or trip
                    are eligible. This assigns the truck and driver to the Sales
                    shipment; it never creates or selects a Trip. Create the
                    Trip later from Sale Orders - Trip Not Started.
                    Other planned shipments using this truck remain visible in
                    Vehicle Availability and are not counted as active trips.
                </p>
                <footer>
                    <button name="action_allocate" string="Assign Truck"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
