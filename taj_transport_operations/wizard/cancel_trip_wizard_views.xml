<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cancel_trip_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.cancel.trip.wizard.form</field>
        <field name="model">taj.transport.cancel.trip.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Transport Trip">
                <group>
                    <field name="trip_id" readonly="1"/>
                    <field name="reason" placeholder="Reason for cancellation..." required="1"/>
                </group>
                <p class="text-muted">
                    Cancellation is final. The active resource assignment
                    will be closed and the reason recorded in the trip history.
                </p>
                <footer>
                    <button name="action_confirm_cancellation" type="object"
                            string="Confirm Cancellation" class="btn-primary"/>
                    <button string="Keep Trip" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
