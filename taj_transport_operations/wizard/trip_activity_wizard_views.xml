<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trip_activity_wizard_form" model="ir.ui.view">
        <field name="name">taj.transport.trip.activity.wizard.form</field>
        <field name="model">taj.transport.trip.activity.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Activity">
                <group>
                    <field name="trip_id" readonly="1"/>
                    <field name="description" placeholder="Describe the latest trip update..."/>
                </group>
                <footer>
                    <button string="Submit" name="action_submit" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
