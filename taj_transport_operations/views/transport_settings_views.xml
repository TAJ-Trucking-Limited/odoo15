<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_settings_form" model="ir.ui.view">
        <field name="name">taj.transport.settings.form</field>
        <field name="model">taj.transport.settings</field>
        <field name="arch" type="xml">
            <form string="Transport Operations Settings">
                <sheet>
                    <group>
                        <field name="dispatch_cutoff_date" options="{'numeric': True}"/>
                    </group>
                    <group string="Sale Order Line Requirements">
                        <field name="required_shipment_field_ids" widget="many2many_checkboxes"
                               context="{'hide_model': True}"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <p>Checked Shipment and Cargo fields are required whenever a quotation
                       or sales order is saved, including imports and API updates.
                       Unchecked fields are optional. File Type applies only to Goods
                       product lines. Sections, notes and down payments are excluded.
                       Changes apply to this company; existing shipments must meet the
                       new requirements when they are next saved.</p>
                    <group string="Trip Inactivity Alerts">
                        <field name="company_id" readonly="1"/>
                        <field name="inactivity_alerts_enabled"/>
                        <field name="inactivity_hours"/>
                        <field name="inactivity_recipient" required="inactivity_alerts_enabled"/>
                    </group>
                    <p>In Progress trips only. Checks run every 15 minutes.
                       If inactivity continues, reminders repeat after the same
                       configured interval. Submitted updates and recorded
                       milestone arrivals/departures reset the activity clock.</p>
                    <group string="Customer Trip Status Reports">
                        <field name="customer_report_send_times" placeholder="08:00, 16:00"/>
                        <field name="customer_report_timezone"/>
                    </group>
                    <p>These times apply to all customers. Each report includes their In Progress trips.
                       Recipients come from Email and Additional Emails on the customer record.</p>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transport_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">taj.transport.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_transport_settings" name="Settings"
              parent="menu_transport_configuration"
              action="action_transport_settings" sequence="50"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
