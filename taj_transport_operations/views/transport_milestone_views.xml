<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_milestone_list" model="ir.ui.view">
        <field name="name">taj.transport.milestone.list</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <list string="Trips" create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_trip" string="Open Trip" type="object" class="btn-secondary"/>
                    <button name="action_open_next_event_wizard" string="Arrival / Departure" type="object" class="btn-primary"/>
                    <button name="action_open_record_activity" string="Record Activity" type="object" class="btn-secondary"/>
                </header>
                <field name="vehicle_id" optional="show"/>
                <field name="trip_id" optional="show"/>
                <field name="trip_state" widget="badge" decoration-info="trip_state == 'draft'" decoration-warning="trip_state in ('ready','in_progress')" decoration-success="trip_state == 'completed'" decoration-muted="trip_state == 'cancelled'" optional="show" string="Trip Status"/>
                <field name="sale_order_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="sequence" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="milestone_type_id" optional="show"/>
                <field name="planned_arrival_at" optional="show"/>
                <field name="actual_arrival_at" optional="show"/>
                <field name="actual_departure_at" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-warning="state == 'arrived'" decoration-success="state in ('completed', 'departed')" decoration-muted="state == 'skipped'" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_trip" string="Open Trip" type="object" icon="fa-truck" class="btn-link" invisible="not trip_id"/>
                <button name="action_open_record_activity" string="Record Activity" type="object" icon="fa-pencil" invisible="trip_state not in ('draft', 'ready', 'in_progress')"/>
                <button name="action_open_arrival_wizard" string="Arrival" type="object" class="btn-secondary" invisible="actual_arrival_at or state == 'skipped'"/>
                <button name="action_open_departure_wizard" string="Departure" type="object" class="btn-secondary" invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                <button name="action_open_correction_wizard" string="Edit" type="object" class="btn-link" groups="taj_transport_operations.group_transport_manager" invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
            </list>
        </field>
    </record>
    <record id="view_transport_milestone_form" model="ir.ui.view">
        <field name="name">taj.transport.milestone.form</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <form string="Trip Milestone" create="0" delete="0">
                <header>
                    <button name="action_open_arrival_wizard" string="Record Arrival" type="object" class="btn-primary" invisible="actual_arrival_at or state == 'skipped'"/>
                    <button name="action_open_departure_wizard" string="Record Departure" type="object" class="btn-primary" invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                    <button name="action_open_correction_wizard" string="Edit Timestamp" type="object" class="btn-secondary" groups="taj_transport_operations.group_transport_manager" invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
                    <button name="action_open_skip_wizard" string="Skip Checkpoint" type="object" class="btn-secondary" groups="taj_transport_operations.group_transport_manager" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" readonly="1" statusbar_visible="pending,arrived,departed,skipped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_trip" class="oe_stat_button" icon="fa-truck" invisible="not trip_id">
                            <span>Transport Trip</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Trip">
                            <field name="trip_id" readonly="1"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                        </group>
                        <group string="Planning Snapshot">
                            <field name="milestone_type_id" readonly="1"/>
                            <field name="type_name" readonly="1"/>
                            <field name="planned_offset_hours" readonly="1"/>
                            <field name="planned_arrival_at" readonly="1"/>
                            <field name="route_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recorded Events">
                            <field name="actual_arrival_at" readonly="1"/>
                            <field name="arrived_by_id" readonly="1"/>
                            <field name="actual_departure_at" readonly="1"/>
                            <field name="departed_by_id" readonly="1"/>
                        </group>
                        <group string="Historical Confirmation" invisible="not confirmed_at">
                            <field name="confirmed_at" readonly="1"/>
                            <field name="confirmed_by_id" readonly="1"/>
                            <field name="confirmation_note" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Checkpoint History" name="milestone_history">
                            <field name="event_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="recorded_at"/>
                                    <field name="event_type"/>
                                    <field name="source"/>
                                    <field name="occurred_at"/>
                                    <field name="user_id"/>
                                    <field name="field_name" optional="hide"/>
                                    <field name="old_value" optional="show"/>
                                    <field name="new_value" optional="show"/>
                                    <field name="reason"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Every recorded event and correction is kept
                                here with its author, business time and
                                before/after values. Audit records cannot be
                                edited or deleted.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_transport_milestone_search" model="ir.ui.view">
        <field name="name">taj.transport.milestone.search</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <search string="Trip Milestones">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="milestone_type_id"/>
                <filter name="trip_in_progress" string="In Progress" domain="[('trip_id.state', '=', 'in_progress')]"/>
                <filter name="trip_completed" string="Completed" domain="[('trip_id.state', '=', 'completed')]"/>
                <filter name="trip_not_started" string="Not Started" domain="[('trip_id.state', 'in', ['draft', 'ready'])]"/>
                <group>
                    <filter name="group_vehicle" string="Truck" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_trip" string="Trip" context="{'group_by': 'trip_id'}"/>
                    <filter name="group_type" string="Checkpoint Type" context="{'group_by': 'milestone_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_transport_milestone" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">taj.transport.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_vehicle': 1, 'search_default_group_trip': 2, 'search_default_trip_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checkpoints match this trip status.</p>
            <p>Trip Status describes the parent trip; each checkpoint keeps its own arrival and departure status.</p>
        </field>
        <field name="domain">[]</field>
    </record>
    <record id="action_transport_milestone_remaining" model="ir.actions.act_window">
        <field name="name">In Progress</field>
        <field name="res_model">taj.transport.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_milestone_search"/>
        <field name="context">{'search_default_group_vehicle': 1, 'search_default_group_trip': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checkpoints match this trip status.</p>
            <p>Trip Status describes the parent trip; each checkpoint keeps its own arrival and departure status.</p>
        </field>
        <field name="domain">[('trip_id.state', '=', 'in_progress')]</field>
    </record>
    <record id="action_transport_milestone_finished" model="ir.actions.act_window">
        <field name="name">Completed</field>
        <field name="res_model">taj.transport.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_milestone_search"/>
        <field name="context">{'search_default_group_vehicle': 1, 'search_default_group_trip': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checkpoints match this trip status.</p>
            <p>Trip Status describes the parent trip; each checkpoint keeps its own arrival and departure status.</p>
        </field>
        <field name="domain">[('trip_id.state', '=', 'completed')]</field>
    </record>
    <record id="action_transport_milestone_draft" model="ir.actions.act_window">
        <field name="name">Not Started</field>
        <field name="res_model">taj.transport.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_milestone_search"/>
        <field name="context">{'search_default_group_vehicle': 1, 'search_default_group_trip': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checkpoints match this trip status.</p>
            <p>Trip Status describes the parent trip; each checkpoint keeps its own arrival and departure status.</p>
        </field>
        <field name="domain">[('trip_id.state', 'in', ['draft', 'ready'])]</field>
    </record>
    <menuitem id="menu_transport_milestones" name="Trips" parent="menu_transport_operations" action="action_transport_milestone" sequence="10" groups="taj_transport_operations.group_transport_user"/>
    <menuitem id="menu_transport_milestones_remaining" name="In Progress" parent="menu_transport_milestones" action="action_transport_milestone_remaining" sequence="10" groups="taj_transport_operations.group_transport_user"/>
    <menuitem id="menu_transport_milestones_finished" name="Completed" parent="menu_transport_milestones" action="action_transport_milestone_finished" sequence="20" groups="taj_transport_operations.group_transport_user"/>
    <menuitem id="menu_transport_milestones_draft" name="Not Started" parent="menu_transport_milestones" action="action_transport_milestone_draft" sequence="30" groups="taj_transport_operations.group_transport_user"/>
</odoo>
