<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_milestone_list" model="ir.ui.view">
        <field name="name">taj.transport.milestone.list</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <list string="Trip Milestones" create="0" delete="0" edit="0">
                <field name="trip_id"/>
                <field name="sequence" optional="hide"/>
                <field name="name"/>
                <field name="milestone_type_id" optional="show"/>
                <field name="planned_arrival_at" optional="show"/>
                <field name="actual_arrival_at"/>
                <field name="actual_departure_at"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'arrived'"
                       decoration-success="state in ('completed', 'departed')"
                       decoration-muted="state == 'skipped'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_arrival_wizard" string="Arrival"
                        type="object" class="btn-secondary"
                        invisible="actual_arrival_at or state == 'skipped'"/>
                <button name="action_open_departure_wizard" string="Departure"
                        type="object" class="btn-secondary"
                        invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                <button name="action_open_correction_wizard" string="Edit"
                        type="object" class="btn-link"
                        groups="taj_transport_operations.group_transport_manager"
                        invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
            </list>
        </field>
    </record>

    <record id="view_transport_milestone_form" model="ir.ui.view">
        <field name="name">taj.transport.milestone.form</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <form string="Trip Milestone" create="0" delete="0">
                <header>
                    <button name="action_open_arrival_wizard" string="Record Arrival"
                            type="object" class="btn-primary"
                            invisible="actual_arrival_at or state == 'skipped'"/>
                    <button name="action_open_departure_wizard" string="Record Departure"
                            type="object" class="btn-primary"
                            invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                    <button name="action_open_correction_wizard" string="Edit Timestamp"
                            type="object" class="btn-secondary"
                            groups="taj_transport_operations.group_transport_manager"
                            invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
                    <button name="action_open_skip_wizard" string="Skip Checkpoint"
                            type="object" class="btn-secondary"
                            groups="taj_transport_operations.group_transport_manager"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="pending,arrived,departed,skipped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_trip"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not trip_id">
                            <span>Transport Trip</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Trip">
                            <field name="trip_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                        </group>
                        <group string="Planning Snapshot">
                            <field name="milestone_type_id" readonly="1"/>
                            <field name="type_name" readonly="1"/>
                            <field name="planned_offset_hours" readonly="1"/>
                            <field name="planned_arrival_at" readonly="1"/>
                            <field name="route_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recorded Events">
                            <field name="actual_arrival_at" readonly="1"/>
                            <field name="arrived_by_id" readonly="1"/>
                            <field name="actual_departure_at" readonly="1"/>
                            <field name="departed_by_id" readonly="1"/>
                        </group>
                        <group string="Historical Confirmation" invisible="not confirmed_at">
                            <field name="confirmed_at" readonly="1"/>
                            <field name="confirmed_by_id" readonly="1"/>
                            <field name="confirmation_note" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Checkpoint History" name="milestone_history">
                            <field name="event_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="recorded_at"/>
                                    <field name="event_type"/>
                                    <field name="source"/>
                                    <field name="occurred_at"/>
                                    <field name="user_id"/>
                                    <field name="field_name" optional="hide"/>
                                    <field name="old_value" optional="show"/>
                                    <field name="new_value" optional="show"/>
                                    <field name="reason"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Every recorded event and correction is kept
                                here with its author, business time and
                                before/after values. Audit records cannot be
                                edited or deleted.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transport_milestone_search" model="ir.ui.view">
        <field name="name">taj.transport.milestone.search</field>
        <field name="model">taj.transport.milestone</field>
        <field name="arch" type="xml">
            <search string="Trip Milestones">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="milestone_type_id"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ['completed', 'departed', 'skipped'])]"/>
                <filter name="my_trips" string="My Trips"
                        domain="[('trip_id.create_uid', '=', uid)]"/>
                <separator/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="arrived" string="Arrived" domain="[('state', '=', 'arrived')]"/>
                <filter name="departed" string="Departed" domain="[('state', '=', 'departed')]"/>
                <filter name="completed" string="Done" domain="[('state', 'in', ['departed', 'completed'])]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_trip" string="Trip"
                            context="{'group_by': 'trip_id'}"/>
                    <filter name="group_type" string="Checkpoint Type"
                            context="{'group_by': 'milestone_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">taj.transport.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No trip milestones yet.</p>
            <p>Select a route template on a transport trip to generate its
               checkpoints, then record arrival and departure
               from the trip.</p>
        </field>
    </record>

    <menuitem id="menu_transport_milestones" name="Milestones"
              parent="menu_transport_operations"
              action="action_transport_milestone" sequence="30"
              groups="taj_transport_operations.group_transport_user"/>
</odoo>
