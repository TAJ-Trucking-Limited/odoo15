<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_milestone_type_list" model="ir.ui.view">
        <field name="name">taj.transport.milestone.type.list</field>
        <field name="model">taj.transport.milestone.type</field>
        <field name="arch" type="xml">
            <list string="Checkpoint Types" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_transport_milestone_type_form" model="ir.ui.view">
        <field name="name">taj.transport.milestone.type.form</field>
        <field name="model">taj.transport.milestone.type</field>
        <field name="arch" type="xml">
            <form string="Checkpoint Type" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        Types classify checkpoints such as loading, departure,
                        border crossing or offloading. They are maintained by
                        the Transport Manager and are not a fixed list.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transport_milestone_type" model="ir.actions.act_window">
        <field name="name">Checkpoint Types</field>
        <field name="res_model">taj.transport.milestone.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_transport_milestone_types" name="Checkpoint Types"
              parent="menu_transport_operations"
              action="action_transport_milestone_type" sequence="40"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
