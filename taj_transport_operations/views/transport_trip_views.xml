<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_trip_list" model="ir.ui.view">
        <field name="name">taj.transport.trip.list</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <list string="Transport Trips" delete="0">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="sale_line_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="transporter_id" optional="show"/>
                <field name="cargo_type_id" optional="show"/>
                <field name="transport_reference" optional="hide"/>
                <field name="initial_vehicle_id" optional="show"/>
                <field name="current_vehicle_id" optional="show"/>
                <field name="current_driver_id" optional="hide"/>
                <field name="container_num" optional="show"/>
                <field name="origin_location" optional="show"/>
                <field name="destination_location" optional="show"/>
                <field name="route_id" optional="hide"/>
                <field name="milestone_progress" optional="hide" widget="progressbar"/>
                <field name="milestone_open_count" optional="hide"/>
                <field name="planned_departure_at" optional="hide"/>
                <field name="planned_arrival_at" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_transport_trip_form" model="ir.ui.view">
        <field name="name">taj.transport.trip.form</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <form string="Transport Trip" delete="0">
                <header>
                    <button string="Mark Ready" name="action_mark_ready"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Start Trip" name="action_start_trip"
                            type="object" class="btn-primary"
                            invisible="state != 'ready'"/>
                    <button string="Complete Trip" name="action_complete_trip"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button string="Cancel Trip" name="action_open_cancel_trip_wizard"
                            type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'ready')"/>
                    <button string="Cancel Trip" name="action_open_cancel_trip_wizard"
                            type="object" class="btn-secondary"
                            groups="taj_transport_operations.group_transport_manager"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,ready,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_sale_order"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <span>Sales Order</span>
                        </button>
                        <button type="object" name="action_open_trip_milestones"
                                class="oe_stat_button" icon="fa-map-marker"
                                invisible="not milestone_count">
                            <field name="milestone_done_count" widget="statinfo"
                                   string="Milestones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Sales Source">
                            <field name="sale_line_id" required="1" readonly="id"
                                   domain="[('order_id.state', 'in', ['sale', 'done']), ('display_type', '=', 'product')]"
                                   options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Truck at Creation">
                            <field name="initial_vehicle_id" readonly="1"/>
                            <field name="container_num" readonly="1"/>
                            <field name="srn" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commercial" name="commercial_details">
                            <group>
                                <group string="Sales Commercial Data (Read Only)">
                                    <field name="customer_reference" readonly="1"/>
                                    <field name="source_document" readonly="1"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="currency_id" readonly="1"/>
                                    <field name="payment_term_id" readonly="1"/>
                                </group>
                                <group string="Operational Commercial Data">
                                    <field name="transporter_id" readonly="state in ('completed', 'cancelled')"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="transport_reference" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Carrier or booking reference"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Sales amounts, customer references and payment terms
                                remain managed on the Sales Order. Editing the
                                operational details here never changes an invoice.
                            </p>
                        </page>
                        <page string="Cargo" name="cargo_details">
                            <group>
                                <group string="Sales Cargo Data (Read Only)">
                                    <field name="container_num" readonly="1"/>
                                    <field name="file_name" readonly="1"/>
                                    <field name="srn" readonly="1"/>
                                    <field name="consignee" readonly="1"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="size" readonly="1"/>
                                    <field name="cargo_quantity" readonly="1"/>
                                    <field name="cargo_uom_id" readonly="1"/>
                                    <field name="sale_description" readonly="1"/>
                                </group>
                                <group string="Operational Cargo Data">
                                    <field name="cargo_type_id" readonly="state in ('completed', 'cancelled')"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="cargo_description" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Actual goods to transport"/>
                                    <field name="special_handling_instructions" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Loading, storage and handling instructions"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Cargo type, operational description and special
                                handling instructions are dispatcher-managed.
                                Missing Sales cargo fields do not block a Draft trip.
                            </p>
                        </page>
                        <page string="Route &amp; Timing" name="route_timing">
                            <group>
                                <group string="Route">
                                    <field name="route_id"
                                           readonly="state in ('completed', 'cancelled')"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="origin_location" readonly="state in ('completed', 'cancelled')" placeholder="Loading / departure location"/>
                                    <field name="destination_location" readonly="state in ('completed', 'cancelled')" placeholder="Unloading / delivery location"/>
                                    <field name="route_notes" readonly="state in ('completed', 'cancelled')" placeholder="Route and dispatch instructions"/>
                                    <button string="Fill Route from Product"
                                            name="action_prefill_route_from_product"
                                            type="object" class="btn-secondary"
                                            invisible="state != 'draft' or (origin_location and destination_location)"/>
                                </group>
                                <group string="Schedule">
                                    <field name="planned_departure_at" readonly="state in ('completed', 'cancelled')"/>
                                    <field name="planned_arrival_at" readonly="state in ('completed', 'cancelled')"/>
                                    <field name="actual_departure_at" readonly="state in ('completed', 'cancelled')"/>
                                    <field name="actual_arrival_at" readonly="state in ('completed', 'cancelled')"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Enter route details and planned times during planning.
                                Actual times are entered manually for now. Selecting a
                                route template copies its checkpoints into the
                                Milestones tab; editing the template later never
                                changes a trip that was already generated. GPS
                                detection is a later phase.
                            </p>
                        </page>
                        <page string="Milestones" name="trip_milestones">
                            <group>
                                <group string="Checkpoint Progress">
                                    <field name="milestone_progress" widget="progressbar"/>
                                    <field name="milestone_count"/>
                                    <field name="milestone_done_count"/>
                                    <field name="milestone_open_count"/>
                                </group>
                                <group string="Checkpoint Actions">
                                    <field name="generated_route_id" readonly="1"/>
                                    <button string="Generate Checkpoints"
                                            name="action_generate_milestones"
                                            type="object" class="btn-secondary"
                                            invisible="not route_id or milestone_count or state != 'draft'"/>
                                    <button string="Regenerate Checkpoints"
                                            name="action_open_regenerate_milestones_wizard"
                                            type="object" class="btn-secondary"
                                            invisible="not route_id or not milestone_count or state != 'draft'"/>
                                    <button string="Add Checkpoint"
                                            name="action_open_add_milestone_wizard"
                                            type="object" class="btn-secondary"
                                            invisible="state in ('completed', 'cancelled')"/>
                                </group>
                            </group>
                            <field name="milestone_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="sequence" optional="hide"/>
                                    <field name="name"/>
                                    <field name="milestone_type_id" optional="show"/>
                                    <field name="planned_arrival_at" optional="show"/>
                                    <field name="actual_arrival_at"/>
                                    <field name="actual_departure_at"/>
                                    <field name="confirmed_at" optional="hide"/>
                                    <field name="requires_confirmation" optional="hide"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'"
                                           decoration-warning="state == 'awaiting_confirmation'"
                                           decoration-success="state in ('completed', 'departed')"
                                           decoration-muted="state == 'skipped'"/>
                                    <field name="notes" optional="hide"/>
                                    <button name="action_open_arrival_wizard" string="Arrival"
                                            type="object" class="btn-secondary"
                                            invisible="actual_arrival_at or state == 'skipped'"/>
                                    <button name="action_open_departure_wizard" string="Departure"
                                            type="object" class="btn-secondary"
                                            invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                                    <button name="action_open_confirmation_wizard" string="Confirm"
                                            type="object" class="btn-secondary"
                                            invisible="not actual_arrival_at or confirmed_at or state == 'skipped'"/>
                                    <button name="action_open_correction_wizard" string="Correct"
                                            type="object" class="btn-link"
                                            groups="taj_transport_operations.group_transport_manager"
                                            invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Arrival and departure are recorded manually per
                                checkpoint. Checkpoints requiring business
                                confirmation (loading, offloading) stay
                                <b>Awaiting Confirmation</b> until operations
                                confirm them. Open checkpoints never block
                                Ready, Start or Complete: completion only reports
                                them. Corrections require the Transport Manager
                                role and a reason, and are kept in the checkpoint
                                history.
                            </p>
                        </page>
                        <page string="Resources" name="trip_resources">
                            <field name="current_assignment_id" invisible="1"/>
                            <group>
                                <group string="Current Assignment"
                                       invisible="state in ('completed', 'cancelled')">
                                    <field name="current_vehicle_id" readonly="1"/>
                                    <field name="current_trailer_id" readonly="1"/>
                                    <field name="current_driver_id" readonly="1"/>
                                    <field name="current_co_driver_id" readonly="1"/>
                                </group>
                                <group string="Last Assigned Resources"
                                       invisible="state not in ('completed', 'cancelled')">
                                    <field name="last_vehicle_id" readonly="1"/>
                                    <field name="last_trailer_id" readonly="1"/>
                                    <field name="last_driver_id" readonly="1"/>
                                    <field name="last_co_driver_id" readonly="1"/>
                                </group>
                                <group string="Resource Actions">
                                    <button string="Assign Initial Resources"
                                            name="action_open_initial_assignment_wizard"
                                            type="object" class="btn-primary"
                                            invisible="current_assignment_id or state != 'draft'"/>
                                    <button string="Replace Resources"
                                            name="action_open_replace_assignment_wizard"
                                            type="object" class="btn-primary"
                                            invisible="not current_assignment_id or state not in ('draft', 'ready', 'in_progress')"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                The original Sales truck remains a snapshot.
                                Assign the operational truck and crew here.
                                Drivers are Contacts, following the Odoo Fleet model.
                            </p>
                            <separator string="Assignment History"/>
                            <field name="assignment_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="vehicle_id"/>
                                    <field name="trailer_id"/>
                                    <field name="driver_id"/>
                                    <field name="co_driver_id"/>
                                    <field name="effective_location" optional="hide"/>
                                    <field name="reason"/>
                                    <field name="assigned_by_id"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lifecycle" name="trip_lifecycle">
                            <group>
                                <group string="Operational Milestones">
                                    <field name="ready_at" readonly="1"/>
                                    <field name="started_at" readonly="1"/>
                                    <field name="completed_at" readonly="1"/>
                                    <field name="cancelled_at" readonly="1"/>
                                </group>
                                <group string="Cancellation" invisible="state != 'cancelled'">
                                    <field name="cancelled_by_id" readonly="1"/>
                                    <field name="cancellation_reason" readonly="1"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                State transitions are controlled actions.
                                Start/Complete stamp missing actual times.
                                Completion and cancellation close the active resource
                                assignment, keeping all history and the original Sales truck.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_trip_search" model="ir.ui.view">
        <field name="name">taj.transport.trip.search</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <search string="Transport Trips">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="transporter_id"/>
                <field name="transport_reference"/>
                <field name="cargo_type_id"/>
                <field name="origin_location"/>
                <field name="destination_location"/>
                <field name="initial_vehicle_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_transporter" string="Transporter" context="{'group_by': 'transporter_id'}"/>
                    <filter name="by_sales_order" string="Sales Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_trip" model="ir.actions.act_window">
        <field name="name">Transport Trips</field>
        <field name="res_model">taj.transport.trip</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transport trips yet.</p>
            <p>Open a confirmed Sales Order to select lines and create trips.</p>
        </field>
    </record>

    <menuitem id="menu_transport_operations" name="Transport Operations"
              groups="taj_transport_operations.group_transport_user" sequence="50"/>
    <menuitem id="menu_transport_trips" name="Trips" parent="menu_transport_operations"
              action="action_transport_trip" sequence="10"
              groups="taj_transport_operations.group_transport_user"/>
    <menuitem id="menu_transport_configuration" name="Configuration"
              parent="menu_transport_operations" sequence="90"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
