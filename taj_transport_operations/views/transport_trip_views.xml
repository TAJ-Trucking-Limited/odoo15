<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_trip_list" model="ir.ui.view">
        <field name="name">taj.transport.trip.list</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <list string="Trips Summary" delete="0"
                  decoration-danger="activity_status == 'overdue'"
                  decoration-success="state == 'completed'"
                  decoration-info="state in ('draft', 'ready')"
                  decoration-muted="state == 'cancelled'">
                <field name="name" optional="show" string="Trip"/>
                <field name="transport_file_id" optional="show"/>
                <field name="file_type_id" optional="show"/>
                <field name="clearing_service" optional="show"/>
                <field name="sale_order_id" optional="show" string="Sales Order Number"/>
                <field name="partner_id" optional="show" string="Customer Name"/>
                <field name="consignee" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="sale_description" optional="show" string="Product Description"/>
                <field name="cargo_quantity" optional="hide" string="QTY"/>
                <field name="current_vehicle_id" optional="show" string="Vehicle"/>
                <field name="eta" optional="show"/>
                <field name="etol" optional="show"/>
                <field name="cargo_type_id" optional="show"/>
                <field name="size" optional="show"/>
                <field name="weight" optional="show"/>
                <field name="cargo_description" optional="show" string="Cargo Desc."/>
                <field name="special_handling_instructions" optional="show"/>
                <field name="allocation_date" optional="show"/>
                <field name="last_milestone_activity" optional="show"/>
                <field name="last_milestone_at" optional="show"/>
                <field name="current_driver_id" optional="show" string="Current Driver"/>
                <field name="milestone_progress" optional="show" widget="progressbar"/>
                <field name="state" optional="show" string="Trip Status" widget="badge" decoration-info="state in ('draft', 'ready')" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"/>
                <field name="activity_status" optional="show" widget="badge" decoration-danger="activity_status == 'overdue'" decoration-success="activity_status == 'recent'"/>
                <field name="last_activity_at" optional="show"/>
                <field name="email_position_preview" optional="show" string="Current Position"/>
                <field name="email_position_map_url" optional="show" string="Map" widget="url" text="View Map"/>
                <field name="email_position_source" optional="hide" string="Position Source"/>
                <field name="email_position_updated_at" optional="hide" string="Position Updated At"/>
                <field name="container_num" optional="show"/>
                <field name="origin_location" optional="show"/>
                <field name="destination_location" optional="show"/>
                <field name="initial_vehicle_id" optional="hide"/>
                <field name="sale_line_id" optional="hide"/>
                <field name="partner_email" optional="hide"/>
                <field name="transporter_id" optional="show"/>
                <field name="transport_reference" optional="hide"/>
                <field name="route_id" optional="hide"/>
                <field name="milestone_open_count" optional="hide"/>
                <field name="actual_departure_at" optional="hide" string="Actual Start"/>
                <field name="actual_arrival_at" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_transport_trip_form" model="ir.ui.view">
        <field name="name">taj.transport.trip.form</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <form string="Transport Trip" delete="0" js_class="taj_transport_trip_form">
                <header>
                    <button name="action_open_record_activity" string="Record Activity"
                            type="object" class="btn-secondary"
                            invisible="not id or state not in ['draft', 'ready', 'in_progress']"/>
                    <button string="Fill Empty Fields"
                            name="action_open_fill_empty_fields_wizard"
                            type="object" class="btn-secondary"
                            groups="taj_transport_operations.group_transport_user"
                            invisible="not id"/>
                    <button string="Start Trip" name="action_open_start_trip_wizard"
                            type="object" class="btn-primary"
                            invisible="state not in ('draft', 'ready')"/>
                    <button string="Complete Trip" name="action_complete_trip"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button string="Cancel Trip" name="action_open_cancel_trip_wizard"
                            type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'ready')"/>
                    <button string="Cancel Trip" name="action_open_cancel_trip_wizard"
                            type="object" class="btn-secondary"
                            groups="taj_transport_operations.group_transport_manager"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,ready,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_sale_order"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <span>Sales Order</span>
                        </button>
                        <button type="object" name="action_open_trip_milestones"
                                class="oe_stat_button" icon="fa-map-marker"
                                invisible="not milestone_count">
                            <field name="milestone_done_count" widget="statinfo"
                                   string="Milestones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Sales Source">
                            <field name="company_id" invisible="1"/>
                            <field name="sale_order_id" required="1" readonly="id"
                                   domain="[('state', 'in', ['sale', 'done'])]"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   context="{'transport_order_label': True}"/>
                            <field name="sale_line_id" required="1" readonly="id"
                                   domain="[('order_id', '=', sale_order_id), ('display_type', 'in', [False, 'product']), ('product_id', '!=', False), ('transport_trip_ids', '=', False)]"
                                   context="{'transport_line_label': True}"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="source_product_tmpl_id" invisible="1"/>
                            <field name="route_id" required="not id" readonly="id"
                                   invisible="id"
                                   domain="[('active', '=', True), ('company_id', '=', company_id), ('product_tmpl_id', '=', source_product_tmpl_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="partner_email" readonly="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Truck at Creation">
                            <field name="initial_vehicle_id" readonly="1"/>
                            <field name="container_num" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="trip_summary">
                            <group>
                                <group string="Shipment">
                                    <field name="transport_file_id" readonly="1"/>
                                    <field name="file_type_id" readonly="1"/>
                                    <field name="clearing_service" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="sale_description" string="Product Description" readonly="1"/>
                                    <field name="consignee" readonly="1"/>
                                    <field name="container_num" readonly="1"/>
                                    <field name="eta" readonly="1"/>
                                    <field name="etol" readonly="1"/>
                                    <field name="cargo_type_id" readonly="1"/>
                                    <field name="size" readonly="1"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="cargo_quantity" string="QTY" readonly="1"/>
                                    <field name="cargo_description" readonly="1"/>
                                    <field name="special_handling_instructions" readonly="1"/>
                                </group>
                                <group col="1">
                                    <group string="Resources">
                                        <field name="current_vehicle_id" readonly="1"/>
                                        <field name="current_driver_id" readonly="1"/>
                                    </group>
                                    <group string="Trip Progress" name="trip_progress_section">
                                        <field name="allocation_date" readonly="1"/>
                                        <field name="actual_departure_at" string="Actual Start" readonly="state in ('completed', 'cancelled')"/>
                                        <field name="last_milestone_activity" readonly="1"/>
                                        <field name="last_milestone_at" readonly="1"/>
                                        <field name="milestone_progress" widget="progressbar" readonly="1"/>
                                        <field name="activity_status" widget="badge" readonly="1"/>
                                        <field name="last_activity_at" readonly="1"/>
                                        <field name="email_position_preview" string="Current Position" readonly="1"/>
                                        <field name="email_position_source" readonly="1"/>
                                        <field name="email_position_updated_at" readonly="1"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                        <page string="Activity History" name="activity_history" invisible="not id">
                            <group>
                                <field name="last_activity_at" readonly="1"/>
                                <field name="last_inactivity_alert_at" readonly="1"/>
                            </group>
                            <field name="trip_activity_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="recorded_at"/>
                                    <field name="user_id"/>
                                    <field name="activity_type"/>
                                    <field name="milestone_id" optional="show"/>
                                    <field name="occurred_at" optional="hide"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operation" name="commercial_details">
                            <group>
                                <group string="Operational Data">
                                    <field name="transporter_id" readonly="state in ('completed', 'cancelled')"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="transport_reference" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Carrier or booking reference"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Sales amounts, customer references and payment terms
                                remain managed on the Sales Order. Editing the
                                operational details here never changes an invoice.
                            </p>
                        </page>
                        <page string="Cargo" name="cargo_details">
                            <group>
                                <group string="Sales Cargo Data (Read Only)">
                                    <field name="container_num" readonly="1"/>
                                    <field name="consignee" readonly="1"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="size" readonly="1"/>
                                    <field name="cargo_quantity" readonly="1"/>
                                    <field name="cargo_uom_id" readonly="1"/>
                                    <field name="sale_description" readonly="1"/>
                                </group>
                                <group string="Operational Cargo Data">
                                    <field name="cargo_type_id" readonly="state in ('completed', 'cancelled')"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="cargo_description" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Actual goods to transport"/>
                                    <field name="special_handling_instructions" readonly="state in ('completed', 'cancelled')"
                                           placeholder="Loading, storage and handling instructions"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Cargo type, operational description and special
                                handling instructions are dispatcher-managed.
                                Missing Sales cargo fields do not block a Draft trip.
                            </p>
                        </page>
                        <page string="Route &amp; Timing" name="route_timing">
                            <group>
                                <group string="Route">
                                    <field name="route_id"
                                           readonly="state in ('completed', 'cancelled')"
                                           domain="[('active', '=', True), ('company_id', '=', company_id)] + ([('product_tmpl_id', '=', source_product_tmpl_id)] if not id else [])"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="origin_location" readonly="state in ('completed', 'cancelled')" placeholder="Loading / departure location"/>
                                    <field name="destination_location" readonly="state in ('completed', 'cancelled')" placeholder="Unloading / delivery location"/>
                                    <field name="route_notes" readonly="state in ('completed', 'cancelled')" placeholder="Route and dispatch instructions"/>
                                    <button string="Fill Route from Product"
                                            name="action_prefill_route_from_product"
                                            type="object" class="btn-secondary"
                                            invisible="state != 'draft' or (origin_location and destination_location)"/>
                                </group>
                                <group string="Schedule">
                                    <field name="actual_departure_at" string="Actual Start" readonly="state in ('completed', 'cancelled')"/>
                                    <field name="actual_arrival_at" readonly="state in ('completed', 'cancelled')"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Enter route details during planning.
                                Actual times are entered manually for now. Selecting a
                                route template copies its checkpoints into the
                                Milestones tab; editing the template later never
                                changes a trip that was already generated. GPS
                                detection is a later phase.
                            </p>
                        </page>
                        <page string="Milestones" name="trip_milestones">
                            <group>
                                <group string="Checkpoint Progress">
                                    <field name="milestone_progress" widget="progressbar"/>
                                    <field name="milestone_count"/>
                                    <field name="milestone_done_count"/>
                                    <field name="milestone_open_count"/>
                                </group>
                                <group string="Checkpoint Actions">
                                    <field name="generated_route_id" readonly="1"/>
                                    <button string="Generate Checkpoints"
                                            name="action_generate_milestones"
                                            type="object" class="btn-secondary"
                                            invisible="not route_id or milestone_count or state != 'draft'"/>
                                    <button string="Regenerate Checkpoints"
                                            name="action_open_regenerate_milestones_wizard"
                                            type="object" class="btn-secondary"
                                            invisible="not route_id or not milestone_count or state != 'draft'"/>
                                    <button string="Add Checkpoint"
                                            name="action_open_add_milestone_wizard"
                                            type="object" class="btn-secondary"
                                            invisible="state in ('completed', 'cancelled')"/>
                                </group>
                            </group>
                            <field name="milestone_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="sequence" optional="hide"/>
                                    <field name="name"/>
                                    <field name="milestone_type_id" optional="show"/>
                                    <field name="planned_arrival_at" optional="show"/>
                                    <field name="actual_arrival_at"/>
                                    <field name="actual_departure_at"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'"
                                           decoration-warning="state == 'arrived'"
                                           decoration-success="state in ('completed', 'departed')"
                                           decoration-muted="state == 'skipped'"/>
                                    <field name="notes" optional="hide"/>
                                    <button name="action_open_arrival_wizard" string="Arrival"
                                            type="object" class="btn-secondary"
                                            invisible="actual_arrival_at or state == 'skipped'"/>
                                    <button name="action_open_departure_wizard" string="Departure"
                                            type="object" class="btn-secondary"
                                            invisible="not actual_arrival_at or actual_departure_at or state == 'skipped'"/>
                                    <button name="action_open_correction_wizard" string="Edit"
                                            type="object" class="btn-link"
                                            groups="taj_transport_operations.group_transport_manager"
                                            invisible="state in ('pending', 'skipped') or not actual_arrival_at"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Arrival and departure are recorded manually per
                                checkpoint. Recording Departure completes the
                                checkpoint. Open checkpoints never block
                                Ready, Start or Complete: completion only reports
                                them. Corrections require the Transport Manager
                                role and a reason, and are kept in the checkpoint
                                history.
                            </p>
                        </page>
                        <page string="Resources" name="trip_resources">
                            <field name="current_assignment_id" invisible="1"/>
                            <group>
                                <group string="Current Assignment"
                                       invisible="state in ('completed', 'cancelled')">
                                    <field name="current_vehicle_id" readonly="1"/>
                                    <field name="current_trailer_id" readonly="1"/>
                                    <field name="current_driver_id" readonly="1"/>
                                    <field name="current_co_driver_id" readonly="1"/>
                                </group>
                                <group string="Last Assigned Resources"
                                       invisible="state not in ('completed', 'cancelled')">
                                    <field name="last_vehicle_id" readonly="1"/>
                                    <field name="last_trailer_id" readonly="1"/>
                                    <field name="last_driver_id" readonly="1"/>
                                    <field name="last_co_driver_id" readonly="1"/>
                                </group>
                                <group string="Resource Actions">
                                    <button string="Apply Fleet Defaults"
                                            name="action_apply_initial_fleet_defaults"
                                            type="object" class="btn-secondary"
                                            invisible="current_assignment_id or not initial_vehicle_id or state != 'draft'"/>
                                    <button string="Assign Initial Resources"
                                            name="action_open_initial_assignment_wizard"
                                            type="object" class="btn-primary"
                                            invisible="current_assignment_id or state != 'draft'"/>
                                    <button string="Replace Resources"
                                            name="action_open_replace_assignment_wizard"
                                            type="object" class="btn-primary"
                                            invisible="not current_assignment_id or state not in ('draft', 'ready', 'in_progress')"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                The original Sales truck remains a snapshot.
                                Assign the operational truck and crew here.
                                Drivers are Contacts, following the Odoo Fleet model.
                            </p>
                            <separator string="Assignment History"/>
                            <field name="assignment_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="vehicle_id"/>
                                    <field name="trailer_id"/>
                                    <field name="driver_id"/>
                                    <field name="co_driver_id"/>
                                    <field name="effective_location" optional="hide"/>
                                    <field name="reason"/>
                                    <field name="assigned_by_id"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Email Updates" name="trip_email_updates">
                            <group>
                                <group string="Update Settings">
                                    <field name="email_notification_enabled" widget="boolean_toggle"/>
                                    <field name="email_partner_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           domain="[('commercial_partner_id', '=', commercial_partner_id)]"
                                           placeholder="Select customer contacts..."/>
                                    <field name="email_extra_recipients"
                                           placeholder="e.g. logistics@client.com, tracking@client.com"/>
                                    <field name="email_interval_hours"/>
                                </group>
                                <group string="Schedule &amp; Live Position">
                                    <field name="email_next_send_at" readonly="1"/>
                                    <field name="email_last_queued_at" readonly="1"/>
                                    <field name="email_failure_count" readonly="1"
                                           invisible="not email_failure_count"/>
                                    <field name="email_last_error" readonly="1"
                                           invisible="not email_last_error"/>
                                    <field name="email_position_preview" readonly="1"/>
                                    <field name="email_position_source" readonly="1"/>
                                    <field name="email_position_updated_at" readonly="1"/>
                                    <field name="email_position_map_url" widget="url" text="View on Map"
                                           invisible="not email_position_map_url" readonly="1"/>
                                    <field name="email_position_notice" readonly="1"
                                           invisible="not email_position_notice"/>
                                    <button string="Send Update Email Now"
                                            name="action_send_email_update_manual"
                                            type="object" class="btn-primary"
                                            icon="fa-envelope"
                                            invisible="state == 'draft'"/>
                                </group>
                            </group>
                            <separator string="Dispatch History"/>
                            <field name="email_dispatch_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="queued_at"/>
                                    <field name="dispatch_type"/>
                                    <field name="requested_by_id"/>
                                    <field name="recipient_emails"/>
                                    <field name="status" widget="badge"
                                           decoration-info="status == 'queued'"
                                           decoration-success="status == 'sent'"
                                           decoration-warning="status == 'partial_failure'"
                                           decoration-danger="status == 'failed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Proof of Delivery" name="proof_of_delivery">
                            <group>
                                <field name="pod_file" filename="pod_filename"/>
                                <field name="pod_filename" invisible="1"/>
                                <field name="pod_notes" placeholder="Optional delivery notes"/>
                            </group>
                        </page>
                        <page string="Lifecycle" name="trip_lifecycle">
                            <group>
                                <group string="Operational Milestones">
                                    <field name="ready_at" readonly="1"/>
                                    <field name="started_at" readonly="1"/>
                                    <field name="completed_at" readonly="1"/>
                                    <field name="cancelled_at" readonly="1"/>
                                </group>
                                <group string="Cancellation" invisible="state != 'cancelled'">
                                    <field name="cancelled_by_id" readonly="1"/>
                                    <field name="cancellation_reason" readonly="1"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                State transitions are controlled actions.
                                Start/Complete stamp missing actual times.
                                Completion and cancellation close the active resource
                                assignment, keeping all history and the original Sales truck.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_trip_search" model="ir.ui.view">
        <field name="name">taj.transport.trip.search</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <search string="Transport Trips">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="transporter_id"/>
                <field name="transport_reference"/>
                <field name="cargo_type_id"/>
                <field name="origin_location"/>
                <field name="destination_location"/>
                <field name="initial_vehicle_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_transporter" string="Transporter" context="{'group_by': 'transporter_id'}"/>
                    <filter name="by_sales_order" string="Sales Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_trip" model="ir.actions.act_window">
        <field name="name">Trips Summary</field>
        <field name="res_model">taj.transport.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'transport_trip_entry': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transport trips yet.</p>
            <p>Click New, choose a confirmed Sales Order and one of its lines,
               then select a matching route template.</p>
        </field>
    </record>

    <record id="action_transport_trip_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_transport_trip_list"/>
        <field name="act_window_id" ref="action_transport_trip"/>
    </record>
    <record id="action_transport_trip_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_transport_trip_form"/>
        <field name="act_window_id" ref="action_transport_trip"/>
    </record>

    <menuitem id="menu_transport_operations" name="TAJ Operations"
              groups="taj_transport_operations.group_transport_user,taj_transport_operations.group_shipment_data_entry,sales_team.group_sale_salesman" sequence="50"/>
    <menuitem id="menu_transport_trips" name="Trips Summary" parent="menu_transport_operations"
              action="action_transport_trip" sequence="80"
              groups="taj_transport_operations.group_transport_user"/>
    <menuitem id="menu_transport_configuration" name="Configuration"
              parent="menu_transport_operations" sequence="90"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
