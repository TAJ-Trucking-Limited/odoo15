<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_trip_list" model="ir.ui.view">
        <field name="name">taj.transport.trip.list</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <list string="Transport Trips" delete="0">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="sale_line_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="transporter_id" optional="show"/>
                <field name="cargo_type" optional="show"/>
                <field name="transport_reference" optional="hide"/>
                <field name="initial_vehicle_id" optional="show"/>
                <field name="current_vehicle_id" optional="show"/>
                <field name="current_driver_id" optional="hide"/>
                <field name="container_num" optional="show"/>
                <field name="origin_location" optional="show"/>
                <field name="destination_location" optional="show"/>
                <field name="planned_departure_at" optional="hide"/>
                <field name="planned_arrival_at" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_transport_trip_form" model="ir.ui.view">
        <field name="name">taj.transport.trip.form</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <form string="Transport Trip" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_sale_order"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <span>Sales Order</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Sales Source">
                            <field name="sale_line_id" required="1" readonly="id"
                                   domain="[('order_id.state', 'in', ['sale', 'done']), ('display_type', '=', 'product')]"
                                   options="{'no_create': True}"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Truck at Creation">
                            <field name="initial_vehicle_id" readonly="1"/>
                            <field name="container_num" readonly="1"/>
                            <field name="srn" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commercial" name="commercial_details">
                            <group>
                                <group string="Sales Commercial Data (Read Only)">
                                    <field name="customer_reference" readonly="1"/>
                                    <field name="source_document" readonly="1"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="currency_id" readonly="1"/>
                                    <field name="payment_term_id" readonly="1"/>
                                </group>
                                <group string="Operational Commercial Data">
                                    <field name="transporter_id"
                                           options="{'no_quick_create': True}"/>
                                    <field name="transport_reference"
                                           placeholder="Carrier or booking reference"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Sales amounts, customer references and payment terms
                                remain managed on the Sales Order. Editing the
                                operational details here never changes an invoice.
                            </p>
                        </page>
                        <page string="Cargo" name="cargo_details">
                            <group>
                                <group string="Sales Cargo Data (Read Only)">
                                    <field name="container_num" readonly="1"/>
                                    <field name="file_name" readonly="1"/>
                                    <field name="srn" readonly="1"/>
                                    <field name="consignee" readonly="1"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="size" readonly="1"/>
                                    <field name="cargo_quantity" readonly="1"/>
                                    <field name="cargo_uom_id" readonly="1"/>
                                    <field name="sale_description" readonly="1"/>
                                </group>
                                <group string="Operational Cargo Data">
                                    <field name="cargo_type"
                                           placeholder="e.g. General cargo"/>
                                    <field name="cargo_description"
                                           placeholder="Actual goods to transport"/>
                                    <field name="special_handling_instructions"
                                           placeholder="Loading, storage and handling instructions"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Cargo type, operational description and special
                                handling instructions are dispatcher-managed.
                                Missing Sales cargo fields do not block a Draft trip.
                            </p>
                        </page>
                        <page string="Route &amp; Timing" name="route_timing">
                            <group>
                                <group string="Route">
                                    <field name="origin_location" placeholder="Loading / departure location"/>
                                    <field name="destination_location" placeholder="Unloading / delivery location"/>
                                    <field name="route_notes" placeholder="Route and dispatch instructions"/>
                                </group>
                                <group string="Schedule">
                                    <field name="planned_departure_at"/>
                                    <field name="planned_arrival_at"/>
                                    <field name="actual_departure_at"/>
                                    <field name="actual_arrival_at"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Enter route details and planned times during planning.
                                Actual times are entered manually for now. Route
                                templates, milestones and GPS automation are out of
                                scope for this batch.
                            </p>
                        </page>
                        <page string="Resources" name="trip_resources">
                            <field name="current_assignment_id" invisible="1"/>
                            <group>
                                <group string="Current Assignment">
                                    <field name="current_vehicle_id" readonly="1"/>
                                    <field name="current_trailer_id" readonly="1"/>
                                    <field name="current_driver_id" readonly="1"/>
                                    <field name="current_co_driver_id" readonly="1"/>
                                </group>
                                <group string="Initial Assignment">
                                    <button string="Assign Initial Resources"
                                            name="action_open_initial_assignment_wizard"
                                            type="object" class="btn-primary"
                                            invisible="current_assignment_id or state != 'draft'"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                The original Sales truck remains a snapshot.
                                Assign the operational truck and crew here.
                                Drivers are Contacts, following the Odoo Fleet model.
                            </p>
                            <separator string="Assignment History"/>
                            <field name="assignment_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="vehicle_id"/>
                                    <field name="trailer_id"/>
                                    <field name="driver_id"/>
                                    <field name="co_driver_id"/>
                                    <field name="effective_location" optional="hide"/>
                                    <field name="reason"/>
                                    <field name="assigned_by_id"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_trip_search" model="ir.ui.view">
        <field name="name">taj.transport.trip.search</field>
        <field name="model">taj.transport.trip</field>
        <field name="arch" type="xml">
            <search string="Transport Trips">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="transporter_id"/>
                <field name="transport_reference"/>
                <field name="cargo_type"/>
                <field name="origin_location"/>
                <field name="destination_location"/>
                <field name="initial_vehicle_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_transporter" string="Transporter" context="{'group_by': 'transporter_id'}"/>
                    <filter name="by_sales_order" string="Sales Order" context="{'group_by': 'sale_order_id'}"/>
                    <filter name="by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_trip" model="ir.actions.act_window">
        <field name="name">Transport Trips</field>
        <field name="res_model">taj.transport.trip</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transport trips yet.</p>
            <p>Open a confirmed Sales Order to select lines and create trips.</p>
        </field>
    </record>

    <menuitem id="menu_transport_operations" name="Transport Operations"
              groups="taj_transport_operations.group_transport_user" sequence="50"/>
    <menuitem id="menu_transport_trips" name="Trips" parent="menu_transport_operations"
              action="action_transport_trip" sequence="10"
              groups="taj_transport_operations.group_transport_user"/>
</odoo>
