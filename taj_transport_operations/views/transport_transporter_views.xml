<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_transporter_list" model="ir.ui.view">
        <field name="name">taj.transport.transporter.list</field>
        <field name="model">taj.transport.transporter</field>
        <field name="arch" type="xml">
            <list string="Transporters">
                <field name="name"/>
                <field name="email" widget="email"/>
            </list>
        </field>
    </record>
    <record id="view_transport_transporter_form" model="ir.ui.view">
        <field name="name">taj.transport.transporter.form</field>
        <field name="model">taj.transport.transporter</field>
        <field name="arch" type="xml">
            <form string="Transporter">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email" widget="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_transport_transporters" model="ir.actions.act_window">
        <field name="name">Transporters</field>
        <field name="res_model">taj.transport.transporter</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_transport_transporters" name="Transporters"
              parent="menu_transport_configuration"
              action="action_transport_transporters" sequence="40"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
