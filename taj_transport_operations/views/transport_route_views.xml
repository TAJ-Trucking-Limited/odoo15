<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_route_list" model="ir.ui.view">
        <field name="name">taj.transport.route.list</field>
        <field name="model">taj.transport.route</field>
        <field name="arch" type="xml">
            <list string="Route Templates" delete="0">
                <field name="name"/>
                <field name="origin_location" optional="show"/>
                <field name="destination_location" optional="show"/>
                <field name="line_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_transport_route_form" model="ir.ui.view">
        <field name="name">taj.transport.route.form</field>
        <field name="model">taj.transport.route</field>
        <field name="arch" type="xml">
            <form string="Route Template" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Kasumbalesa - Dar es Salaam"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="origin_location" placeholder="Planned loading / departure location"/>
                            <field name="destination_location" placeholder="Planned delivery destination"/>
                        </group>
                        <group string="Configuration">
                            <field name="active"/>
                            <field name="line_count"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkpoints" name="route_checkpoints">
                            <field name="line_ids">
                                <list editable="bottom" delete="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Checkpoint name"/>
                                    <field name="milestone_type_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="planned_offset_days" optional="show"/>
                                    <field name="planned_offset_hours" optional="show"/>
                                    <field name="latitude" optional="hide"/>
                                    <field name="longitude" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Checkpoints are copied into a trip when the trip
                                selects this route. Editing the template later
                                never changes trips that were already generated.
                                Planned offsets can be entered in days or hours;
                                one day equals 24 hours.
                                Coordinates are optional planning data for the
                                later GPS phase; nothing is detected
                                automatically in this phase.
                            </p>
                        </page>
                        <page string="Notes" name="route_notes">
                            <field name="notes" placeholder="Route description, documents or operational notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transport_route_search" model="ir.ui.view">
        <field name="name">taj.transport.route.search</field>
        <field name="model">taj.transport.route</field>
        <field name="arch" type="xml">
            <search string="Route Templates">
                <field name="name"/>
                <field name="origin_location"/>
                <field name="destination_location"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_route" model="ir.actions.act_window">
        <field name="name">Route Templates</field>
        <field name="res_model">taj.transport.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No route templates yet.</p>
            <p>Define the ordered checkpoints expected on a route, then select
               the template on a transport trip to generate its milestones.</p>
        </field>
    </record>

    <menuitem id="menu_transport_routes" name="Route Templates"
              parent="menu_transport_configuration"
              action="action_transport_route" sequence="20"
              groups="taj_transport_operations.group_transport_manager"/>
</odoo>
